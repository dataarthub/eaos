{
  "source": {
    "jobs": {
      "verify": {
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 30,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        },
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "fetch-depth": 0
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": "${{ matrix.node }}"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.3"
            }
          },
          {
            "run": "bun install --frozen-lockfile --ignore-scripts --linker hoisted"
          },
          {
            "run": "bun run secrets:setup"
          },
          {
            "name": "Select from trusted successful main ancestor",
            "id": "public-selection",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "node scripts/workflow-supply/public/quality.mjs plan"
          },
          {
            "name": "Run selected project verification",
            "if": "matrix.node == 24",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "bun run quality:ci"
          },
          {
            "run": "bunx playwright install --with-deps chromium",
            "if": "steps.public-selection.outputs.scope == 'full'"
          },
          {
            "name": "Prepare and test exact archives",
            "run": "node scripts/release.mjs prepare > .verification/candidate-path.txt\nbun run test:consumer -- \"$(cat .verification/candidate-path.txt)\"\nbun run release:verify -- \"$(cat .verification/candidate-path.txt)\"\n",
            "if": "steps.public-selection.outputs.scope == 'full'"
          },
          {
            "uses": "actions/upload-artifact@v7",
            "with": {
              "name": "verified-public-candidate",
              "path": ".verification/release-*/",
              "retention-days": 14,
              "include-hidden-files": true,
              "if-no-files-found": "error"
            },
            "if": "steps.public-selection.outputs.scope == 'full'"
          }
        ],
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "node": [
              24
            ]
          }
        },
        "permissions": {
          "contents": "read",
          "actions": "read"
        }
      }
    }
  },
  "publish": {
    "run-name": "${{ github.event_name == 'workflow_dispatch' && format('Complete npm staging run {0}', inputs.staged_run) || format('Stage npm Release {0}', github.event.release.tag_name) }}",
    "env": {
      "RELEASE_REPOSITORY_PRIVATE": "${{ github.event.repository.private }}"
    },
    "jobs": {
      "verify": {
        "if": "github.event_name == 'release' && github.repository == 'dataarthub/eaos' && github.event.release.draft == false && github.event.release.prerelease == false && startsWith(github.event.release.tag_name, 'eaos-')",
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 45,
        "outputs": {
          "artifact": "${{ steps.upload.outputs.artifact-id }}"
        },
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "ref": "${{ github.sha }}",
              "fetch-depth": 0,
              "persist-credentials": false
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": 24
            }
          },
          {
            "name": "Validate published package Release, source and selected version",
            "id": "select",
            "run": "node scripts/publish/context.mjs"
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.3"
            }
          },
          {
            "run": "npm install --global npm@11.21.0 --ignore-scripts --registry=https://registry.npmjs.org"
          },
          {
            "run": "bun install --frozen-lockfile --ignore-scripts --linker hoisted --registry=https://registry.npmjs.org"
          },
          {
            "name": "Require exact-commit authoritative Source quality",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "node scripts/workflow-supply/public/quality.mjs require-source"
          },
          {
            "run": "bun run secrets:setup"
          },
          {
            "run": "bun run check",
            "env": {
              "NODE_OPTIONS": "--max-old-space-size=8192"
            }
          },
          {
            "run": "bun run secrets:check -- --history"
          },
          {
            "run": "bunx playwright install --with-deps chromium"
          },
          {
            "name": "Prepare and test exact commit-bound release archives",
            "run": "node scripts/release.mjs prepare --final > .verification/candidate-path.txt\nbun run test:consumer -- \"$(cat .verification/candidate-path.txt)\"\nbun run release:verify -- \"$(cat .verification/candidate-path.txt)\"\nnode scripts/publish/bundle.mjs \"$(cat .verification/candidate-path.txt)\" .verification/handoff\n"
          },
          {
            "uses": "actions/upload-artifact@v7",
            "id": "upload",
            "with": {
              "name": "verified-npm-release-${{ github.run_id }}-${{ github.run_attempt }}",
              "path": ".verification/handoff/release.json\n.verification/handoff/*.tgz\n.verification/handoff/*.notes.md\n",
              "if-no-files-found": "error",
              "include-hidden-files": true,
              "retention-days": 14
            }
          }
        ],
        "permissions": {
          "contents": "read",
          "actions": "read"
        },
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      },
      "stage": {
        "needs": "verify",
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 10,
        "permissions": {
          "contents": "read",
          "id-token": "write",
          "actions": "read"
        },
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "ref": "${{ github.sha }}",
              "fetch-depth": 0,
              "persist-credentials": false
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": 24
            }
          },
          {
            "run": "npm install --global npm@11.21.0 --ignore-scripts --registry=https://registry.npmjs.org"
          },
          {
            "uses": "actions/download-artifact@v8",
            "with": {
              "artifact-ids": "${{ needs.verify.outputs.artifact }}",
              "path": ".verification/handoff",
              "digest-mismatch": "error"
            }
          },
          {
            "name": "Revalidate exact original Source quality evidence",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "node scripts/workflow-supply/public/quality.mjs require-source"
          },
          {
            "name": "Submit exact verified archives for human npm approval",
            "run": "node scripts/publish/run.mjs stage"
          }
        ]
      },
      "resolve": {
        "if": "github.event_name == 'workflow_dispatch' && github.repository == 'dataarthub/eaos' && github.ref == 'refs/heads/main'",
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 5,
        "permissions": {
          "contents": "read",
          "actions": "read"
        },
        "outputs": {
          "run": "${{ steps.original.outputs.run }}",
          "artifact": "${{ steps.original.outputs.artifact }}",
          "commit": "${{ steps.original.outputs.commit }}"
        },
        "steps": [
          {
            "name": "Require trusted default branch",
            "run": "test \"$GITHUB_REF\" = refs/heads/main"
          },
          {
            "uses": "actions/checkout@v6",
            "with": {
              "ref": "${{ github.sha }}",
              "persist-credentials": false
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": 24
            }
          },
          {
            "name": "Resolve original successful staging attempt and immutable artifact",
            "id": "original",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}",
              "STAGED_RUN": "${{ inputs.staged_run }}"
            },
            "run": "mkdir -p .verification && node scripts/publish/evidence.mjs"
          }
        ]
      },
      "complete": {
        "needs": "resolve",
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 10,
        "permissions": {
          "contents": "read",
          "actions": "read",
          "id-token": "write",
          "deployments": "write"
        },
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "ref": "${{ github.sha }}",
              "fetch-depth": 0,
              "persist-credentials": false
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": 24
            }
          },
          {
            "run": "npm install --global npm@11.21.0 --ignore-scripts --registry=https://registry.npmjs.org"
          },
          {
            "name": "Revalidate original run identity before handoff",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}",
              "STAGED_RUN": "${{ inputs.staged_run }}"
            },
            "run": "mkdir -p .verification && node scripts/publish/evidence.mjs"
          },
          {
            "uses": "actions/download-artifact@v8",
            "with": {
              "artifact-ids": "${{ needs.resolve.outputs.artifact }}",
              "run-id": "${{ needs.resolve.outputs.run }}",
              "github-token": "${{ github.token }}",
              "path": ".verification/handoff",
              "digest-mismatch": "error"
            }
          },
          {
            "name": "Revalidate exact original Source quality evidence",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "node scripts/workflow-supply/public/quality.mjs require-source"
          },
          {
            "name": "Verify approved public bytes, repair channels and record original-SHA success",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}",
              "STAGED_RUN": "${{ inputs.staged_run }}"
            },
            "run": "node scripts/publish/run.mjs complete"
          }
        ],
        "env": {
          "PUBLISH_SOURCE_SHA": "${{ needs.resolve.outputs.commit }}",
          "STAGED_RUN": "${{ inputs.staged_run }}"
        }
      }
    }
  },
  "complete": {
    "jobs": {
      "observe": {
        "if": "github.repository == 'dataarthub/eaos' && github.event.workflow_run.event == 'release' && github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_repository.full_name == github.repository",
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 35,
        "permissions": {
          "contents": "read",
          "actions": "write"
        },
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "ref": "main",
              "fetch-depth": 0,
              "persist-credentials": false
            }
          },
          {
            "uses": "actions/setup-node@v6",
            "with": {
              "node-version": 24,
              "package-manager-cache": false
            }
          },
          {
            "name": "Resolve original successful staging attempt and immutable artifact",
            "id": "source",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "mkdir -p .verification && node scripts/publish/observe.mjs resolve"
          },
          {
            "uses": "actions/download-artifact@v8",
            "with": {
              "artifact-ids": "${{ steps.source.outputs.artifact }}",
              "run-id": "${{ steps.source.outputs.run }}",
              "github-token": "${{ github.token }}",
              "path": ".verification/handoff",
              "digest-mismatch": "error"
            }
          },
          {
            "name": "Observe npm approval and request completion once",
            "env": {
              "GITHUB_TOKEN": "${{ github.token }}"
            },
            "run": "node scripts/publish/observe.mjs"
          }
        ]
      }
    }
  },
  "quality": {
    "always": [
      [
        "bun",
        "run",
        "secrets:check",
        "--",
        "--history"
      ]
    ],
    "tasks": [
      {
        "id": "documentation-safety",
        "command": [
          "node",
          "scripts/workflow-adapter.mjs",
          "documentation-safety"
        ],
        "cache": false,
        "primaryOnly": true,
        "scopes": [
          "docs",
          "publication"
        ]
      },
      {
        "id": "documentation",
        "command": [
          "bun",
          "run",
          "docs:check"
        ],
        "primaryOnly": true,
        "scopes": [
          "docs"
        ]
      },
      {
        "id": "source",
        "command": [
          "bun",
          "run",
          "check:selected"
        ],
        "outputs": [
          "packages/core/dist",
          "packages/server/dist",
          "packages/react/dist",
          "packages/cli/dist",
          "plugins/dist",
          ".verification/quality.json",
          ".verification/quality-latest.json"
        ],
        "primaryOnly": true,
        "scopes": [
          "full"
        ]
      },
      {
        "id": "publication-tooling",
        "command": [
          "bun",
          "run",
          "test:publish-tooling"
        ],
        "primaryOnly": true,
        "scopes": [
          "publication"
        ]
      },
      {
        "id": "publication-docs",
        "command": [
          "bun",
          "run",
          "docs:check"
        ],
        "primaryOnly": true,
        "scopes": [
          "publication"
        ]
      }
    ],
    "impact": {
      "packages": [
        "packages/core",
        "packages/server",
        "packages/react",
        "packages/cli",
        "plugins"
      ]
    }
  },
  "conformance": {
    "behaviorCommands": [
      [
        "bun",
        "run",
        "test:tooling"
      ]
    ],
    "probeInputs": {
      "test:tooling": [
        "scripts/",
        "biome.json",
        ".gitleaks.toml"
      ]
    },
    "toolSetup": "secrets:setup",
    "selectionTests": [
      "scripts/package-selection.test.mjs"
    ]
  }
}
