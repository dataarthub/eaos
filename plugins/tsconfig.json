{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "*/src/**/*.ts",
    "*/src/**/*.tsx",
    "*/manifest.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
